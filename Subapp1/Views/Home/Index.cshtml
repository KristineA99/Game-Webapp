@{
    ViewData["Title"] = "Home Page";
}

@* Loads the black and white style for the question pages *@
@section Styles {
    <link rel="stylesheet" href="~/css/questions.css" asp-append-version="true" />
}

<div class="text-center">
    <h1 class="display-4">Monster Munch</h1>
    <p class="lead">Munch your way to an A!</p>
</div>

<div class="row align-items-center mt-4">
    
    <div class="col-md-3 d-flex align-items-center align-self-stretch justify-content-center flex-column gap-3">
        @*buttons to create user(currently not leading anywhere) and play game*@
        <button type="button" class="btn btn-primary btn-lg">Create User</button>
        <button type="button" class="btn btn-primary btn-lg" onclick="location.href='/Game/Play'">Play Game</button>
    </div>

    <div class="col-md-6 d-flex justify-content-center">
        @*temporary image from https://unsplash.com/photos/green-and-brown-plush-toy-rlf7br_QJas *@
        <img src="~/images/temporaryHomepageMonster.jpg" class="img-fluid rounded-3" alt="Monster Image" style="max-width: 400px;">

    </div>

    <div class="col-md-3">
        @*temporary Leaderboard with mock data*@
        <h2>Leaderboard</h2>
        <table class="table table-primary table-borderless leaderboard-table">
            
            <tr>
                <td class="rounded-circle text-center"> 1 </td>
                <td class= "rounded-start-3"> TopUser</td>
                <td class="rounded-end-3"> 100</td>
            </tr>
            <tr>
                <td class="rounded-circle text-center"> 2 </td>
                <td class="rounded-start-3"> ClassClown</td>
                <td class="rounded-end-3"> 90</td>
            </tr>
            <tr>
                <td class="rounded-circle text-center"> 3 </td>
                <td class="rounded-start-3"> Bob03</td>
                <td class="rounded-end-3"> 80</td>
            </tr>
            <tr>
                <td class="rounded-circle text-center"> 4 </td>
                <td class="rounded-start-3"> BigBrain</td>
                <td class="rounded-end-3"> 70</td>
            </tr>

        </table>
    </div>
</div>
