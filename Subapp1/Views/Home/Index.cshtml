@{
    ViewData["Title"] = "Home Page";
}

@* Loads the black and white style from the question pages *@
@section Styles {
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
}

<div class="text-center">
    <h1 class="display-4 mt-4 mb-0">Monster Munch</h1>
    <p class="lead">Munch your way to an A!</p>
</div>

<div class="d-flex justify-content-center mt-4">
    @*button play game*@
    <button type="button" class="btn btn-lg home-action-button" onclick="location.href='/Game/Play'">Play Game</button>
</div>
