@{
    ViewData["Title"] = "Home Page";
}

@* Loads the black and white style for the question pages *@
@section Styles {
    <link rel="stylesheet" href="~/css/questions.css" asp-append-version="true" />
}

<div class="text-center">
    <h1 class="display-4">Monster Munch</h1>
    <p class="lead">Munch your way to an A!</p>
</div>

<div class="row align-items-center mt-4">
    
    <div class="col-md-3 d-flex align-items-center align-self-stretch justify-content-center flex-column gap-3">
        @*buttons to create user(currently not leading anywhere) and play game*@
        <button type="button" class="btn btn-lg home-action-button">Create User</button>
        <button type="button" class="btn btn-lg home-action-button" onclick="location.href='/Game/Play'">Play Game</button>
    </div>

    <div class="col-md-6 d-flex justify-content-center">
        @*temporary image from https://unsplash.com/photos/green-and-brown-plush-toy-rlf7br_QJas *@
        <img src="~/images/temporaryHomepageMonster.jpg" class="img-fluid rounded-3" alt="Monster Image" style="max-width: 400px;">

    </div>

    <div class="col-md-3">
        @*temporary Leaderboard with mock data*@
        <table class="table table-striped">
            <thead>
                <tr>
                    <th></th>
                    <th class="fs-5">Leaderboard</th>
                    <th></th>
                </tr>
            </thead>
            
            <tr>
                <td class="border border-black border-2 text-center"> 1 </td>
                <td> TopUser</td>
                <td> 100</td>
            </tr>
            <tr>
                <td class="border border-black border-2 text-center"> 2 </td>
                <td> ClassClown</td>
                <td> 90</td>
            </tr>
            <tr>
                <td class="border border-black border-2 text-center"> 3 </td>
                <td> Bob03</td>
                <td> 80</td>
            </tr>
            <tr>
                <td class="border border-black border-2 text-center"> 4 </td>
                <td> BigBrain</td>
                <td> 70</td>
            </tr>

        </table>
    </div>
</div>
