@model Subapp1.ViewModels.QuizFormViewModel

@{
    ViewData["Title"] = "Create Quiz";
}

<h1>Create Quiz</h1>

<form asp-controller="Quiz" asp-action="Create" method="post">

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Title" class="form-label"></label>
        <input asp-for="Title" class="form-control" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <h4>Select Questions</h4>
        <p>Choose at least one question for this quiz.</p>

        <span asp-validation-for="SelectedQuestionIds"
              class="text-danger"></span>

        @foreach (var question in Model.AvailableQuestions)
        {
            <div class="form-check">
                <input type="checkbox"
                       name="SelectedQuestionIds"
                       value="@question.Value"
                       checked="@question.Selected"
                       class="form-check-input"
                       id="question-@question.Value" />

                <label class="form-check-label"
                       for="question-@question.Value">
                    @question.Text
                </label>
            </div>
        }
    </div>

    <button type="submit" class="btn btn-primary">
        Create Quiz
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Cancel
    </a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}