@model Subapp1.Models.GameViewModel

@{
    ViewData["Title"] = "Play"; 
}

@* Loads the styles used by the game page *@
@section Styles {
  
    <link rel="stylesheet" href="~/css/game.css" asp-append-version="true" />
}

<div class="game-container">
    <h1>Battle!</h1>

    <div class="monster">
        <img src="~/images/monster2.gif" alt="Monster" class="monster-image" />
    </div>

    @* If a question has been passed to this view, display it *@
    @if (Model.Question != null)
    {
        <div class="question">

            <h2>@Model.Question.Text</h2>
            
            @* No answer has been submitted yet: show the answer options*@
            @if (Model.IsCorrect == null)
            {
                <form asp-controller="Game" asp-action="Answer" method="post" class="answer-options">

                    <input type="hidden" name="questionId" value="@Model.Question.QuestionId" />
                    <input type="hidden" name="score" value="@Model.Score" />

                    <button type="submit" name="selectedOption" value="1">
                        @Model.Question.OptionA
                    </button>

                    <button type="submit" name="selectedOption" value="2">
                        @Model.Question.OptionB
                    </button>

                    <button type="submit" name="selectedOption" value="3">
                        @Model.Question.OptionC
                    </button>

                    <button type="submit" name="selectedOption" value="4">
                        @Model.Question.OptionD
                    </button>

                </form>
            }
            else
            {
                @* An answer has been submitted: show the result*@
                if (Model.IsCorrect == true)
                {
                <p class="answer-result correct">Correct!</p>
                }
                else
                {
                <p class="answer-result incorrect">Wrong!</p>
                }
        
                @* Continue should only appear after answering*@
                <form asp-controller="Game" asp-action="Continue" method="post">
                    <input type="hidden" name="score" value="@Model.Score" />

                    <button type="submit" class="continue-button">Continue</button>
                </form>  
            } 
        </div>
    }

    @* The attack button is not visible after the question has been displayed *@
    @if (Model.Question == null) 
    {
    @* Creates the button for attack and corresponds with Gamecontroller to call the Attack() action *@
        <form asp-controller="Game" asp-action="Attack" method="post" class="attack-form">

            <button type="submit" class="attack-button">Attack</button>

        </form>
    }

    <div class="score">
        <span class="score-icon"><img src="~/images/medal.png" alt="" class="score-image"></span>
        <span class="score-label">Score:</span> 
        <span class="score-value">@Model.Score</span>
   </div>

</div>