@model Subapp1.ViewModels.GameViewModel

@{
    ViewData["Title"] = "Game Result";
}

@section Styles {
    <link rel="stylesheet" href="~/css/game.css" asp-append-version="true" />
}

<div class="game-container">
    @* Display the victory message when the controller marks the game as won. *@
    @if (Model.HasWon)
    {
        <div class="victory">
            <img src="~/images/trophy.png" alt="" class="victory-trophy" />
            <h1>Victory!</h1>
            <p>You've munched your way through every question and completed <strong>@Model.QuizName</strong>!</p>
        </div>
    }

    <div class="score">
        <span class="score-icon"><img src="~/images/medal.png" alt="" class="score-image"></span>
        <span class="score-label">Final Score:</span>
        <span class="score-value">@Model.Score/@Model.TotalQuestions</span>
    </div>

    @if (Model.SaveFailed)
    {
        <div class="alert alert-warning" role="alert">
            @if (Model.CanRetrySave)
            {
                <span>
                    Your quiz is complete, but we couldn't save your result to My Progress.
                    Try saving again while your game session is active.
                </span>
            }
            else
            {
                <span>
                    Your quiz is complete, but some required game information is
                    missing or invalid. This result cannot be saved.
                    Please start a new game.
                </span>
            }
        </div>
    }

    <div class="game-result-actions">
        @if (Model.SaveFailed && Model.CanRetrySave)
            {
                <form asp-controller="Game" asp-action="Continue" method="post">
                    <button type="submit" class="btn btn-primary">
                        Retry Saving
                    </button>
                </form>
            }
            else
            {
                <a asp-controller="Game" asp-action="Play" class="btn btn-primary">
                    Play Again
                </a>

                @if (!Model.SaveFailed && User.Identity?.IsAuthenticated == true)
                {
                    <a asp-controller="Progress" asp-action="Index" class="btn btn-secondary">
                        View My Progress
                    </a>
                }
            }
    </div>

    @* Keep the unsaved-result warning below the action buttons, outside their flex layout.
       Only show it when the player still has an opportunity to retry saving. *@
    @if (Model.SaveFailed && Model.CanRetrySave)
    {
        <p>Starting another game or letting your session expire will discard this attempt's unsaved result.</p>
    }
</div>