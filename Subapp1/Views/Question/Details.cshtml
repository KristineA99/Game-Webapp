@model Subapp1.Models.Question

@*
    Shows all information about one question, including all four answer options.
    It is shown by QuestionController.Details(int id).
*@

@* Sets the page title shown in the browser tab *@
@{
    ViewData["Title"] = "Question details";
}

<h1>Question details</h1>

@*
    A description list shows the information as label/value pairs:
    dt = the label, dd = the value.
*@
<dl class="row">
    @* The question text *@
    <dt class="col-sm-3">Question</dt>
    <dd class="col-sm-9">@Model.Text</dd>

    @* The four answer options *@
    <dt class="col-sm-3">A</dt>
    <dd class="col-sm-9">@Model.OptionA</dd>
    <dt class="col-sm-3">B</dt>
    <dd class="col-sm-9">@Model.OptionB</dd>
    <dt class="col-sm-3">C</dt>
    <dd class="col-sm-9">@Model.OptionC</dd>
    <dt class="col-sm-3">D</dt>
    <dd class="col-sm-9">@Model.OptionD</dd>

    @* Shows the text of the correct option, using the helper property CorrectOptionText in Question.cs *@
    <dt class="col-sm-3">Correct answer</dt>
    <dd class="col-sm-9">@Model.CorrectOptionText</dd>
</dl>

@* Opens the edit form for this question (asp-route-id adds the id to the link, e.g. /Question/Update/3) *@
<a asp-action="Update" asp-route-id="@Model.QuestionId" class="btn btn-primary">Edit</a>

@* Goes back to the list of all questions *@
<a asp-action="Index" class="btn btn-secondary">Back to list</a>