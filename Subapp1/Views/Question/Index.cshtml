@model IEnumerable<Subapp1.Models.Question>

@* 
    Lists all questions in a table.
    From here the admin can add, view, edit and delete questions.
*@

@* Sets the page title shown in the browser tab *@
@{
    ViewData["Title"] = "Manage questions";
}

@* Loads the black and white style for the question pages *@
@section Styles {
    <link rel="stylesheet" href="~/css/questions.css" asp-append-version="true" />
}

@* Page header with the title on the left and the "Add question" button on the right (Bootstrap flexbox classes) *@
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Manage questions
        @* Animated monster next to the heading *@
        <img src="~/images/monster1.gif" alt="" class="heading-gif" />
    </h1>
    <a asp-action="Create" class="btn btn-primary">Add question</a>
</div>

@* Shows a confirmation message after creating, updating or deleting (set with TempData in the controller) *@
@if (TempData["Message"] != null)
{
    <div class="alert alert-success">@TempData["Message"]</div>
}

@* Shows a friendly message if there are no questions yet, otherwise the table *@
@if (!Model.Any())
{
    <p>No questions yet. Add the first one to get the game started.</p>
}
else
{
    @* table-responsive makes the table scroll sideways on small screens instead of breaking the layout *@
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            
            @* Column headings. The last column is empty because it holds the buttons *@
            <thead>
                <tr>
                    <th>Question</th>
                    <th></th>
                </tr>
            </thead>

            @* One table row for each question in the list *@
            <tbody>
                @foreach (var question in Model)
                {
                    <tr>
                        <td>@question.Text</td>
                        @*
                            Buttons for this question.
                        *@
                        <td class="text-end text-nowrap">
                            <a asp-action="Update" asp-route-id="@question.QuestionId" class="btn btn-sm btn-outline-primary">Edit</a>
                            <a asp-action="Delete" asp-route-id="@question.QuestionId" class="btn btn-sm btn-outline-danger">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}