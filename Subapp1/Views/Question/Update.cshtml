@model Subapp1.Models.Question

@* 
    Fditing an existing question.
    It is shown by QuestionController.Update(int id) (HttpGet) with the question's current values,
    and when the form is submitted it is sent to QuestionController.Update(Question question) (HttpPost).
    If validation fails, the controller shows this page again with error messages.
*@

@* Sets the page title shown in the browser tab *@
@{
    ViewData["Title"] = "Edit question";
}

@* Loads the black and white style for the question pages *@
@section Styles {
    <link rel="stylesheet" href="~/css/questions.css" asp-append-version="true" />
}

<h1>Edit question</h1>

@*
    asp-action="Update" sends the form to the Update action in QuestionController.
    method="post" means the data is sent in the request body (HttpPost).
*@
<form asp-action="Update" method="post">
   
    @* The id must be sent back so the right question is updated *@
    <input type="hidden" asp-for="QuestionId" />

    @* Inserts the shared form fields from _QuestionForm.cshtml, filled in with the current values *@
    <partial name="_QuestionForm" model="Model" />

    @* Button that submits the form *@
    <button type="submit" class="btn btn-primary">Save changes</button>
    
    @* Goes back to the question list without saving *@
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>

@* Shows validation errors in the browser before the form is sent *@
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}