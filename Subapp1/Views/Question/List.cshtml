@model IEnumerable<Subapp1.Models.Question>

@* 
    Lists all questions in a table.
    From here the admin can add, view, edit and delete questions.
*@

@{
    ViewData["Title"] = "Manage questions";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Manage questions</h1>
    <a asp-action="Create" class="btn btn-primary">Add question</a>
</div>

@* Shows a confirmation message after creating, updating or deleting (set with TempData in the controller) *@
@if (TempData["Message"] != null)
{
    <div class="alert alert-success">@TempData["Message"]</div>
}

@* Shows a friendly message if there are no questions yet, otherwise the table *@
@if (!Model.Any())
{
    <p>No questions yet. Add the first one to get the game started.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Question</th>
                    <th>Correct answer</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var question in Model)
                {
                    <tr>
                        <td>@question.Text</td>
                        <td>@question.CorrectOptionText</td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Details" asp-route-id="@question.QuestionId" class="btn btn-sm btn-outline-secondary">Details</a>
                            <a asp-action="Update" asp-route-id="@question.QuestionId" class="btn btn-sm btn-outline-primary">Edit</a>
                            <a asp-action="Delete" asp-route-id="@question.QuestionId" class="btn btn-sm btn-outline-danger">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}